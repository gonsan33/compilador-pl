package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: return getScanner().next_token(); :};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal     ENT,  MAS, MENOS, POR, DIV, PAP, PCIERRE, CAP, CCIERRE, LLAP, LLCIERRE,
             DOSPUNTOS, FUNDEF, VARDEF, IGUAL, COMA, PUNTOCOMA, MAYORIGUAL, MAYOR, MENORIGUAL, MENOR, AMPERSAND, 
             DOLAR, AND, OR, NOT, MOD, ASIGN, IF, ELSE, FOR, WHILE, RETURN,
             NEW, DELETE, BOOL, INT, TYPEDEF, STRUCT, TRUE, FALSE, PRINT, SCAN, IDEN, PUNTO;

non terminal  PROGRAMA, LISTA_INSTRUCCIONES, INSTRUCCION,  DECL_FUNCION, FUNCION, DECL_TIPO, DECL_VARIABLE,
DECL_STRUCT, TIPO_DE_VARIABLE, EXPRESION, E0, E1, E2, E3, DESIGNADOR, LLAMADA_FUNCION, T1, T2, LISTA_DECLARACIONES,
LISTA_DECLARACIONES_REST, TFUN, D1, D2, INSTR_CONTROL, INSTR_WHILE , INSTR_FOR , INSTR_IF , INSTR_RETURN , RAMA_ELSE,
EXPRESION_OPT, LISTA_ARGUMENTOS, LISTA_ARGUMENTOS_REST, BLOQUE, ASIGNACION, INSTR_PRINT, INSTR_SCAN;

PROGRAMA ::= LISTA_INSTRUCCIONES ;
LISTA_INSTRUCCIONES ::= INSTRUCCION LISTA_INSTRUCCIONES | ;
INSTRUCCION ::= DECL_FUNCION PUNTOCOMA | FUNCION | DECL_TIPO PUNTOCOMA | DECL_VARIABLE PUNTOCOMA | BLOQUE | INSTR_CONTROL | INSTR_PRINT | INSTR_SCAN | DELETE DESIGNADOR PUNTOCOMA | ASIGNACION; 

ASIGNACION ::= DESIGNADOR ASIGN EXPRESION PUNTOCOMA;
INSTR_PRINT ::= PRINT PAP EXPRESION PCIERRE PUNTOCOMA;
INSTR_SCAN ::= SCAN PAP DESIGNADOR PCIERRE PUNTOCOMA;

DECL_VARIABLE ::= VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo {: RESULT = new VariableDeclarationNode(id, tipo) :}
 | VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo ASIGN EXPRESION:expr {: RESULT = new VariableDeclarationNode(id, tipo, expr) :} 
 | VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo ASIGN NEW TIPO_DE_VARIABLE:tipo2 {: RESULT = new VariableDeclarationNode(id, tipo, new NewNode(tipo2)) :};

EXPRESION ::= EXPRESION:l MAYORIGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.GEQ, l, r) :}
| EXPRESION:l MAYOR E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.GT, l, r) :}
 | EXPRESION:l MENORIGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.LEQ, l, r) :}
 | EXPRESION:l MENOR E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.LT, l, r) :}
 | EXPRESION:l IGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.EQ, l, r) :}
 | E0:res {: RESULT = res :};
E0 ::= E0:l MAS E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.SUM, l, r) :} 
| E0:l MENOS E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.DIFFERENCE, l, r) :}
| E0:l OR E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.OR, l, r) :}
| E1:res {: RESULT = res :};
E1 ::= E1:l POR E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.MULTIPLICATION, l, r) :} | E1:l DIV E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.DIVISION, l, r) :} | E1:l AND E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.AND, l, r) :} | 
E1:l MOD E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.MODULE, l, r) :} | 
E2:res {: RESULT = res :};
E2 ::= DOLAR E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.DOLAR, e) :} 
| AMPERSAND E3:e {: RESULT = new UnaryExpressionNode(UnaryOperation.AMPERSAND, e) :} 
| MAS E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.MAS, e) :} 
| MENOS E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.MENOS, e) :} 
| NOT E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.NOT, e) :} 
| E3: e {: RESULT = e :};
E3 ::= DESIGNADOR: d {: RESULT = d :} | LLAMADA_FUNCION:f {: RESULT = f :} | ENT:e {: RESULT = e :} | TRUE:t {: RESULT = t :} | FALSE:f {: RESULT = f :} | PAP EXPRESION:e PCIERRE {: RESULT = e :};


TIPO_DE_VARIABLE ::= CAP ENT CCIERRE TIPO_DE_VARIABLE | T1 ;
T1 ::= DOLAR T1 | T2 ;
T2 ::= IDEN | BOOL | INT | DECL_STRUCT | PAP TIPO_DE_VARIABLE PCIERRE;

DECL_STRUCT ::= STRUCT PAP LISTA_DECLARACIONES PCIERRE;
LISTA_DECLARACIONES ::= IDEN DOSPUNTOS TIPO_DE_VARIABLE LISTA_DECLARACIONES_REST | ;
LISTA_DECLARACIONES_REST ::= COMA IDEN DOSPUNTOS TIPO_DE_VARIABLE LISTA_DECLARACIONES_REST | ;
DECL_TIPO ::= TYPEDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE;
DECL_FUNCION ::= FUNDEF IDEN PAP LISTA_DECLARACIONES PCIERRE TFUN ;
TFUN ::= DOSPUNTOS TIPO_DE_VARIABLE | ;

FUNCION ::= DECL_FUNCION BLOQUE;
BLOQUE ::= LLAP LISTA_INSTRUCCIONES LLCIERRE;

DESIGNADOR ::= DESIGNADOR CAP EXPRESION CCIERRE | D1 ;
D1 ::= D1 PUNTO D2 | D2 ;
D2 ::= IDEN;

LLAMADA_FUNCION ::= IDEN PAP LISTA_ARGUMENTOS PCIERRE;
LISTA_ARGUMENTOS ::= EXPRESION LISTA_ARGUMENTOS_REST | ;
LISTA_ARGUMENTOS_REST ::= COMA EXPRESION LISTA_ARGUMENTOS_REST | ;

INSTR_CONTROL ::= INSTR_WHILE | INSTR_FOR | INSTR_IF | INSTR_RETURN;

INSTR_WHILE ::= WHILE PAP EXPRESION PCIERRE BLOQUE;
EXPRESION_OPT ::= EXPRESION | ;
INSTR_FOR ::= FOR PAP EXPRESION_OPT PUNTOCOMA EXPRESION_OPT PUNTOCOMA EXPRESION_OPT PCIERRE BLOQUE;
INSTR_IF ::= IF PAP EXPRESION PCIERRE BLOQUE RAMA_ELSE;
RAMA_ELSE ::= ELSE IF PAP EXPRESION PCIERRE BLOQUE RAMA_ELSE | ELSE BLOQUE | ;
INSTR_RETURN ::= RETURN EXPRESION PUNTOCOMA;



