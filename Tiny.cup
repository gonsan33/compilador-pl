package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: return getScanner().next_token(); :};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal     ENT,  MAS, MENOS, POR, DIV, PAP, PCIERRE, CAP, CCIERRE, LLAP, LLCIERRE
             DOSPUNTOS, FUNDEF, VARDEF, IGUAL, COMA, PUNTOCOMA, MAYORIGUAL, MAYOR, MENORIGUAL, MENOR, AMPERSAND, 
             DOLAR, AND, OR, NOT, MOD, ASIGN, IF, ELSE, FOR, WHILE, RETURN,
             NEW, DELETE, BOOL, INT, TYPE, STRUCT, TRUE, FALSE, IDEN;

non terminal  PROGRAMA, LISTA_INSTRUCCIONES, INSTRUCCION,  DECL_FUNCION, FUNCION, DECL_TIPO, DECL_VARIABLE, DECL_STRUCT, TIPO_DE_VARIABLE, EXPRESION

PROGRAMA ::= LISTA_INSTRUCCIONES ; 
LISTA_INSTRUCCIONES ::== INSTRUCCION LISTA_INSTRUCCIONES | ; 
INSTRUCCION ::= DECL_FUNCION | FUNCION | DECL_TIPO | DECL_VARIABLE ; 

DECL_VARIABLE ::= VARDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE PUNTOCOMA | VARDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE IGUAL EXPRESION; 

TIPO_DE_VARIABLE ::= DOLAR TIPO_DE_VARIABLE | IDEN | BOOL | INT | DECL_STRUCT | DECL_ARRAY 

