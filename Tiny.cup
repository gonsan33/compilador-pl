package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import alex.TokenValue;
import errors.GestionErroresTiny;

import ast.*;
import java.util.ArrayList;

scan with {: return getScanner().next_token(); :};
parser code {:
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {:
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};

terminal TokenValue IDEN, ENT;

terminal     MAS, MENOS, POR, DIV, PAP, PCIERRE, CAP, CCIERRE, LLAP, LLCIERRE,
             DOSPUNTOS, FUNDEF, VARDEF, IGUAL, COMA, PUNTOCOMA, MAYORIGUAL, MAYOR, MENORIGUAL, MENOR, AMPERSAND,
             DOLAR, AND, OR, NOT, MOD, ASIGN, IF, ELSE, FOR, WHILE, RETURN,
             NEW, DELETE, BOOL, INT, TYPEDEF, STRUCT, TRUE, FALSE, PRINT, SCAN, PUNTO;


non terminal ExpressionNode EXPRESION, E0, E1, E2, E3, EXPRESION_OPT;
non terminal DesignatorNode DESIGNADOR, D1, D2, D3;
non terminal TypeNode TIPO_DE_VARIABLE, T1, T2;
non terminal ProgramNode PROGRAMA;
non terminal ArrayList<SentenceNode> LISTA_INSTRUCCIONES;
non terminal ArrayList<SentenceNode> LISTA_INSTRUCCIONES_BLOQUE;
non terminal SentenceNode INSTRUCCION, INSTR_CONTROL, ASIGNACION, INSTR_PRINT, INSTR_SCAN, INSTRUCCION_BLOQUE, DECL_VAR_OPT, ASIGNACION_OPT;
non terminal WhileNode INSTR_WHILE;
non terminal ForNode INSTR_FOR;
non terminal IfNode INSTR_IF;
non terminal BlockNode RAMA_ELSE;
non terminal ReturnNode INSTR_RETURN;
non terminal BlockNode BLOQUE;
non terminal VariableDeclarationNode DECL_VARIABLE;
non terminal TypeDeclarationNode DECL_TIPO;
non terminal FunctionNode DECL_FUNCION, FUNCION;
non terminal TypeNode TFUN;
non terminal StructTypeNode DECL_STRUCT;
non terminal ArrayList<ParameterNode> LISTA_DECLARACIONES, LISTA_DECLARACIONES_REST;
non terminal ArrayList<ExpressionNode> LISTA_ARGUMENTOS, LISTA_ARGUMENTOS_REST;

PROGRAMA ::= LISTA_INSTRUCCIONES:l {: RESULT = new ProgramNode(l); :};
LISTA_INSTRUCCIONES ::= INSTRUCCION:i LISTA_INSTRUCCIONES:l {: l.add(0, i); RESULT = l; :}
 | {: RESULT = new ArrayList<SentenceNode>(); :};
INSTRUCCION ::= DECL_FUNCION:d PUNTOCOMA {: RESULT = d; :}
 | FUNCION:f {: RESULT = f; :}
 | DECL_TIPO:d PUNTOCOMA {: RESULT = d; :}
 | DECL_VARIABLE:d PUNTOCOMA {: RESULT = d; :}
 | BLOQUE:b {: RESULT = b; :}
 | INSTR_CONTROL:c {: RESULT = c; :}
 | INSTR_PRINT:p {: RESULT = p; :}
 | INSTR_SCAN:s {: RESULT = s; :}
 | DELETE DESIGNADOR:d PUNTOCOMA {: RESULT = new DeleteNode(d); :}
 | ASIGNACION:a {: RESULT = a; :};
 LISTA_INSTRUCCIONES_BLOQUE ::= INSTRUCCION_BLOQUE:i LISTA_INSTRUCCIONES_BLOQUE:l {: l.add(0, i); RESULT = l; :}
| {: RESULT = new ArrayList<SentenceNode>(); :};
INSTRUCCION_BLOQUE::= DECL_VARIABLE:d PUNTOCOMA {: RESULT = d; :}
 | BLOQUE:b {: RESULT = b; :}
 | INSTR_CONTROL:c {: RESULT = c; :}
 | INSTR_PRINT:p {: RESULT = p; :}
 | INSTR_SCAN:s {: RESULT = s; :}
 | DELETE DESIGNADOR:d PUNTOCOMA {: RESULT = new DeleteNode(d); :}
 | ASIGNACION:a {: RESULT = a; :};

ASIGNACION ::= DESIGNADOR:d ASIGN EXPRESION:e PUNTOCOMA {: RESULT = new AssignNode(d, e); :};
INSTR_PRINT ::= PRINT PAP EXPRESION:e PCIERRE PUNTOCOMA {: RESULT = new PrintNode(e); :};
INSTR_SCAN ::= SCAN PAP DESIGNADOR:d PCIERRE PUNTOCOMA {: RESULT = new ScanNode(d); :};

DECL_VARIABLE ::= VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo {: RESULT = new VariableDeclarationNode(id.lexema, tipo); :}
 | VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo ASIGN EXPRESION:expr {: RESULT = new VariableDeclarationNode(id.lexema, tipo, expr); :}
 | VARDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:tipo ASIGN NEW TIPO_DE_VARIABLE:tipo2 {: RESULT = new VariableDeclarationNode(id.lexema, tipo, new NewNode(tipo2)); :};

EXPRESION ::= EXPRESION:l MAYORIGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.GEQ, l, r); :}
| EXPRESION:l MAYOR E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.GT, l, r); :}
 | EXPRESION:l MENORIGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.LEQ, l, r); :}
 | EXPRESION:l MENOR E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.LT, l, r); :}
 | EXPRESION:l IGUAL E0:r {: RESULT = new BinaryExpressionNode(BinaryOperation.EQ, l, r); :}
 | E0:res {: RESULT = res; :};
E0 ::= E0:l MAS E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.SUM, l, r); :}
| E0:l MENOS E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.DIFFERENCE, l, r); :}
| E0:l OR E1:r {: RESULT = new BinaryExpressionNode(BinaryOperation.OR, l, r); :}
| E1:res {: RESULT = res; :};
E1 ::= E1:l POR E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.MULTIPLICATION, l, r); :} | E1:l DIV E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.DIVISION, l, r); :} | E1:l AND E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.AND, l, r); :} |
E1:l MOD E2:r {: RESULT = new BinaryExpressionNode(BinaryOperation.MODULE, l, r); :} |
E2:res {: RESULT = res; :};
E2 ::= AMPERSAND E3:e {: RESULT = new UnaryExpressionNode(UnaryOperation.AMPERSAND, e); :}
| MAS E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.MAS, e); :}
| MENOS E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.MENOS, e); :}
| NOT E2:e {: RESULT = new UnaryExpressionNode(UnaryOperation.NOT, e); :}
| E3:e {: RESULT = e; :};
E3 ::= DESIGNADOR:d {: RESULT = d; :} | ENT:e {: RESULT = new IntNode(e.lexema);:} | TRUE {: RESULT = new BooleanNode(true); :} | FALSE {: RESULT = new BooleanNode(false); :} | PAP EXPRESION:e PCIERRE {: RESULT = e; :};


TIPO_DE_VARIABLE ::= CAP ENT:s CCIERRE TIPO_DE_VARIABLE:t {: RESULT = new ArrayTypeNode(s.lexema, t); :} | T1:t {: RESULT = t; :};
T1 ::= DOLAR T1:t {: RESULT = new PointerTypeNode(t); :} | T2:t {: RESULT = t; :};
T2 ::= IDEN:id {: RESULT = new CustomTypeNode(id.lexema); :} | BOOL {: RESULT = new BoolTypeNode(); :} | INT {: RESULT = new IntTypeNode(); :} | DECL_STRUCT:s {: RESULT = s; :} | PAP TIPO_DE_VARIABLE:t PCIERRE {: RESULT = t; :};

DECL_STRUCT ::= STRUCT PAP LISTA_DECLARACIONES:l PCIERRE {: RESULT = new StructTypeNode(l); :};
LISTA_DECLARACIONES ::= IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:t LISTA_DECLARACIONES_REST:r {: r.add(0, new ParameterNode(id.lexema, t)); RESULT = r; :}
 | {: RESULT = new ArrayList<ParameterNode>(); :} | IDEN:id DOSPUNTOS AMPERSAND TIPO_DE_VARIABLE:t LISTA_DECLARACIONES_REST:r {: r.add(0, new ParameterNode(id.lexema, t,0)); RESULT = r; :};
LISTA_DECLARACIONES_REST ::= COMA IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:t LISTA_DECLARACIONES_REST:r {: r.add(0, new ParameterNode(id.lexema, t)); RESULT = r; :}
 | {: RESULT = new ArrayList<ParameterNode>(); :} | COMA IDEN:id DOSPUNTOS AMPERSAND TIPO_DE_VARIABLE:t LISTA_DECLARACIONES_REST:r {: r.add(0, new ParameterNode(id.lexema, t,0)); RESULT = r; :};
DECL_TIPO ::= TYPEDEF IDEN:id DOSPUNTOS TIPO_DE_VARIABLE:t {: RESULT = new TypeDeclarationNode(id.lexema, t); :};
DECL_FUNCION ::= FUNDEF IDEN:id PAP LISTA_DECLARACIONES:l PCIERRE TFUN:t {: RESULT = new FunctionNode(id.lexema, l, t, null); :};
TFUN ::= DOSPUNTOS TIPO_DE_VARIABLE:t {: RESULT = t; :} | {: RESULT = null; :};

FUNCION ::= FUNDEF IDEN:id PAP LISTA_DECLARACIONES:l PCIERRE TFUN:t BLOQUE:b {: RESULT = new FunctionNode(id.lexema, l, t, b); :};
BLOQUE ::= LLAP LISTA_INSTRUCCIONES_BLOQUE:l LLCIERRE {: RESULT = new BlockNode(l); :};


LISTA_ARGUMENTOS ::= EXPRESION:e LISTA_ARGUMENTOS_REST:r {: r.add(0, e); RESULT = r; :}
 | {: RESULT = new ArrayList<ExpressionNode>(); :};
LISTA_ARGUMENTOS_REST ::= COMA EXPRESION:e LISTA_ARGUMENTOS_REST:r {: r.add(0, e); RESULT = r; :}
 | {: RESULT = new ArrayList<ExpressionNode>(); :};




DESIGNADOR ::= DESIGNADOR:d CAP EXPRESION:e CCIERRE {: RESULT = new ArrayAccessNode(d, e); :}
| DESIGNADOR:d PUNTO D2:f {: RESULT = new FieldAccessNode(d, f.toString()); :}
| D1:d {: RESULT = d; :};
D1 ::= D2:d {: RESULT = d; :};
D2 ::= IDEN:id {: RESULT = new IdentifierNode(id.lexema); :} |IDEN:id PAP LISTA_ARGUMENTOS:l PCIERRE {: RESULT = new FunctionCallNode(id.lexema, l); :} |D3:d {: RESULT = d; :};
D3 ::= DOLAR D3:d {: RESULT = new PointerAccessNode(d); :} | DOLAR IDEN:id {: RESULT = new PointerAccessNode(new IdentifierNode(id.lexema)); :};

INSTR_CONTROL ::= INSTR_WHILE:w {: RESULT = w; :} | INSTR_FOR:f {: RESULT = f; :} | INSTR_IF:i {: RESULT = i; :} | INSTR_RETURN:r {: RESULT = r; :};

INSTR_WHILE ::= WHILE PAP EXPRESION:e PCIERRE BLOQUE:b {: RESULT = new WhileNode(e, b); :};
EXPRESION_OPT ::= EXPRESION:e {: RESULT = e; :} | {: RESULT = null; :};
DECL_VAR_OPT ::= DECL_VARIABLE:d {: RESULT = d; :} | {: RESULT = null; :};
ASIGNACION_OPT ::= DESIGNADOR:d ASIGN EXPRESION:e {: RESULT = new AssignNode(d, e); :} | {: RESULT = null; :};
INSTR_FOR ::= FOR PAP DECL_VAR_OPT:init PUNTOCOMA EXPRESION_OPT:cond PUNTOCOMA ASIGNACION_OPT:step PCIERRE BLOQUE:b {: RESULT = new ForNode(init, cond, step, b); :};
INSTR_IF ::= IF PAP EXPRESION:e PCIERRE BLOQUE:b RAMA_ELSE:elseB {: RESULT = new IfNode(e, b, elseB); :};
RAMA_ELSE ::= ELSE BLOQUE:b {: RESULT = b; :} | {: RESULT = null; :};
INSTR_RETURN ::= RETURN EXPRESION:e PUNTOCOMA {: RESULT = new ReturnNode(e); :};
