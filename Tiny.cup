package asint;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: return getScanner().next_token(); :};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal     ENT,  MAS, MENOS, POR, DIV, PAP, PCIERRE, CAP, CCIERRE, LLAP, LLCIERRE,
             DOSPUNTOS, FUNDEF, VARDEF, IGUAL, COMA, PUNTOCOMA, MAYORIGUAL, MAYOR, MENORIGUAL, MENOR, AMPERSAND, 
             DOLAR, AND, OR, NOT, MOD, ASIGN, IF, ELSE, FOR, WHILE, RETURN,
             NEW, DELETE, BOOL, INT, TYPEDEF, STRUCT, TRUE, FALSE, PRINT, SCAN, IDEN, PUNTO;

non terminal  PROGRAMA, LISTA_INSTRUCCIONES, INSTRUCCION,  DECL_FUNCION, FUNCION, DECL_TIPO, DECL_VARIABLE, 
DECL_STRUCT, TIPO_DE_VARIABLE, EXPRESION, E0, E1, E2, E3, DESIGNADOR, LLAMADA_FUNCION, T1, T2, LISTA_DECLARACIONES, TFUN, D1, D2;

PROGRAMA ::= LISTA_INSTRUCCIONES ; 
LISTA_INSTRUCCIONES ::= INSTRUCCION LISTA_INSTRUCCIONES | ; 
INSTRUCCION ::= DECL_FUNCION PUNTOCOMA | FUNCION PUNTOCOMA | DECL_TIPO PUNTOCOMA | DECL_VARIABLE PUNTOCOMA ; 

DECL_VARIABLE ::= VARDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE  | VARDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE ASIGN EXPRESION  | VARDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE ASIGN NEW TIPO_DE_VARIABLE ; 

EXPRESION ::= EXPRESION MAYORIGUAL E0 | EXPRESION MAYOR E0 | EXPRESION MENORIGUAL E0 |EXPRESION MENOR E0 | EXPRESION IGUAL E0 | E0; 
E0 ::= E0 MAS E1 | E0 MENOS E1 | E0 OR E1 | E1;
E1 ::= E1 POR E2 | E1 DIV E2 | E1 AND E2 | E1 MOD E2 | E2;
E2 ::= DOLAR E2 | AMPERSAND E3 | MAS E2 | MENOS E2 | NOT E2  | E3; 
E3 ::= DESIGNADOR | LLAMADA_FUNCION | ENT | TRUE | FALSE | PAP EXPRESION PCIERRE;


TIPO_DE_VARIABLE ::=  CAP ENTERO CCIERRE TIPO_DE_VARIABLE | T1 ; 
T1 ::= DOLAR T1 | T2 ; 
T2 ::= IDEN | BOOL | INT | DECL_STRUCT | (TIPO_DE_VARIABLE); 

DECL_STRUCT ::= STRUCT PAP LISTA_DECLARACIONES PCIERRE; 
LISTA_DECLARACIONES ::=  IDEN DOSPUNTOS TIPO_DE_VARIABLE COMA LISTA_DECLARACIONES | ; 
DECL_TIPO ::= TYPEDEF IDEN DOSPUNTOS TIPO_DE_VARIABLE;
DECL_FUNCION ::= FUNDEF IDEN PAP LISTA_DECLARACIONES PCIERRE TFUN ;
TFUN ::= DOSPUNTOS TIPO_DE_VARIABLE | ;

FUNCION ::= DECL_FUNCION BLOQUE;
BLOQUE ::= LLAP LISTA_INSTRUCCIONES LLCIERRE;

DESIGNADOR ::= DESIGNADOR CAP EXPRESION CCIERRE | D1 ; 
D1 ::= D1 PUNTO D2 | D2 ; 
D2 ::= IDEN | (DESIGNADOR); 


