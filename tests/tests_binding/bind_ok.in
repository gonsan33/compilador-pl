var s : miTipo;

var arr : [10]int;

fn suma(a : int, b : int) : int {
    return a + b;
}

var resultado : int = suma(x, 3);

var p : $int = new int;

fn main() {
    {
        var x : int = 10;
        var y : int = suma(x, resultado);
        print(y);
    }

    print(x);

    while (b) {
        x = x - 1;
        b = false;
    }

    if (x == 0) {
        print(x);
    } else {
        print(resultado);
    }

    for (;x < 10;) {
