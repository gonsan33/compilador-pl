"Programa de prueba para JavaEscrig - Versión de compatibilidad total"
"Autores: Gonzalo Sánchez Montesinos, Daniel Bordeianu Dascal y Víctor Gómez Torres"

type punto : struct (x : int, y : int );

fn potencia(base : int, exp : int) : int {
    if (exp == 0) {
        return 1;
    }
    return base * potencia(base, exp - 1);
}

fn resetPunto(p : &punto) {
    p.x = 0;
    p.y = 0;
}

fn swap(a : $int, b : $int) {
    var aux : int = $a;
    $a = $b;
    $b = aux;
}

fn main() : int {
    var n : int;
    print(101); 
    scan(n);

    var nube : [5]punto;
    var i : int = 0;
    var pAux : punto; "Variable auxiliar para evitar accesos complejos"

    while (i < n) {
        print(i);
        
        "Leemos en la variable auxiliar y luego asignamos al array"
        scan(pAux.x);
        scan(pAux.y);
        nube[i] = pAux;
        
        i = i + 1;
    }

"3. Prueba de Punteros"
    var ptrX : $int = new int;
    pAux = nube[0];
    $ptrX = pAux.x;
    
    var copiaY : int = pAux.y;
    
    "Sacamos la dirección a una variable para que el parser no sufra"
    var ptrCopiaY : $int = &copiaY;
    swap(ptrX, ptrCopiaY);
    
    print($ptrX); 
    print(copiaY);

    "..."

    "5. Prueba de paso por referencia"
    var ptrNube : $punto = &nube[0];
    resetPunto(ptrNube);
    
    pAux = nube[0];
    print(pAux.x);

    "4. Prueba de Ámbito"
    var x : int = 50;
    {
        var x : int = 100;
        print(x);
    }
    print(x);

    "5. Prueba de paso por referencia"
    resetPunto(&nube[0]);
    pAux = nube[0];
    print(pAux.x);

    "6. Bucle for y acumulador"
    var totalX : int = 0;
    for (var j : int = 0; j < n; j = j + 1) {
        pAux = nube[j];
        totalX = totalX + pAux.x;
    }
    
    print(totalX);
    
    delete ptrX;
    return 0;
}