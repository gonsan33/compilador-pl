var x : int = 5;
var b : bool = true;
var p : $int = new $int;
var arr : [10]int;
type miTipo : struct(x : int, y : bool);

fn factorial(n : int) : int {
  if (n <= 1) {
    return 1;
  } else {
    return n * factorial(n - 1);
  }
}

fn swap(a : int, b : int) {
  var tmp : int = a;
  a = b;
  b = tmp;
}

fn main() : {
  x = factorial(5);
  print(x); 
  while (x > 0) {
    x = x - 1;
    print(x);

  }

  for (;x < 10;) {
    x = x + 1;
    print(x);

  }

}


