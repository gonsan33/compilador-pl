

fn suma(arr : &[6]int) {
    for(var i : int = 1;  i < 6; i = i + 1){
        arr[i] = arr[i] + arr[i-1];
    }
}


fn main() {
    var arr: [6] int; 
    for(var i : int = 0;  i < 6; i = i + 1){
        arr[i] = i;
    }
    suma(arr);
     for(var i : int = 0;  i < 6; i = i + 1){
        print(arr[i]);
    }
}