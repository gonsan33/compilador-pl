"Programa de prueba para JavaEscrig"
"Autores: Gonzalo Sánchez Montesinos, Daniel Bordeianu Dascal y Víctor Gómez Torres"

type punto : struct (x : int, y : int );

"Función recursiva para calcular la potencia (usada luego en distancias)"
fn potencia(base : int, exp : int) : int {
    if (exp == 0) {
        return 1;
    }
    return base * potencia(base, exp - 1);
}

"Función con paso por referencia para resetear un punto"
fn resetPunto(p : &punto) {
    p.x = 0;
    p.y = 0;
}

"Función que usa punteros para intercambiar dos enteros"
fn swap(a : $int, b : $int) {
    var aux : int = $a;
    $a = $b;
    $b = aux;
}

fn main() : int {
    "1. Prueba de variables básicas y lectura"
    var n : int;
    print(101); "Código de inicio: 101"
    scan(n);

    "2. Prueba de Arrays y Structs"
    var nube : [5]punto;
    var i : int = 0;

    while (i < n) {
        print(i); "Indice actual"
        scan((nube[i]).x);
        scan((nube[i]).y);
        i = i + 1;
    }

    "3. Prueba de Punteros y Operador new/delete"
    var ptrX : $int = new int;
    $ptrX = (nube[0]).x;
    
    var copiaY : int = (nube[0]).y;
    
    "Intercambiamos los valores de la primera coordenada usando punteros"
    swap(ptrX, &copiaY);
    
    print($ptrX);  
    print(copiaY); 

    "4. Prueba de Ámbito (Shadowing)"
    var x : int = 50;
    {
        var x : int = 100;
        print(x); "Debería imprimir 100"
    }
    print(x); "Debería imprimir 50"

    "5. Prueba de paso por referencia"
    resetPunto(&nube[0]);
    print((nube[0]).x); "Debería imprimir 0"

    "6. Bucle for y expresiones complejas"
    var totalX : int = 0;
    for (var j : int = 0; j < n; j = j + 1) {
        totalX = totalX + (nube[j]).x;
    }
    
    print(totalX);
    
    delete ptrX;
    return 0;
}